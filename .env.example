# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is git-ignored: never commit it, and never paste real keys into this example file.

# ---- Required for finding leads (python main.py) ---------------------------
# OpenAI: names competitors, picks websites, extracts partners, finds emails, writes emails.
OPENAI_API_KEY=sk-...
# Firecrawl: scrapes pages a plain fetch can't read (JavaScript-rendered pages).
FIRECRAWL_API_KEY=fc-...

# ---- Optional: upload each run's sheet to Google Drive ---------------------
# Folder link or ID (needs the one-time Google sign-in described in the README).
GOOGLE_DRIVE_FOLDER_ID=

# ---- Required only for sending outreach emails (python send_outreach.py send) ----
OUTREACH_SENDER_NAME=Your Name
OUTREACH_SENDER_TITLE=Your Title
OUTREACH_FROM_EMAIL=you@example.com
# Printed in every email's footer (US law requires a real postal address).
OUTREACH_MAILING_ADDRESS=Street, City, State ZIP, Country
# Gmail: a 16-character App Password (Google Account > Security > App passwords),
# NOT your normal password. Easiest: run `python send_outreach.py setup` to store it.
SMTP_PASSWORD=
# Optional: OUTREACH_REPLY_TO, SMTP_HOST (default smtp.gmail.com), SMTP_PORT (587),
# SMTP_USER (default = OUTREACH_FROM_EMAIL), OUTREACH_DAILY_CAP (25),
# OUTREACH_COMPANY, OUTREACH_COMPANY_WEBSITE (default https://www.waresport.com)

# ---- Optional experiments (NOT used by default; leave commented out) -------
# GOOGLE_API_KEY=            # Gemini, only with LLM_PROVIDER=gemini
# CRAWL4AI_API_KEY=          # Crawl4AI cloud, only with SCRAPE_PROVIDER=crawl4ai
# LLM_PROVIDER=gemini
# SCRAPE_PROVIDER=crawl4ai
